{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "~/*": ["./src/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "tailwind.config.js",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "src/components/common/animations/Temp.tsx",
    "src/components/tagMaintenance/TagTest.tsx",
    "src/components/movies/movieitem/actionbar/ActionBarContainerMINMAX.tsx",
    "src/components/settings/quickSorts/SortEditorNOTUSED.tsx"
  ]
}