{
  "expo": {
    "name": "Little Ape Movies",
    "scheme": "littleapemovies",
    "userInterfaceStyle": "automatic",
    "orientation": "portrait",
    "version": "1.2.5",
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "icon": "./assets/images/papericon2.png",
    "platforms": [
      "ios"
    ],
    "plugins": [
      "./plugins/withIosPodDeploymentTarget",
      [
        "expo-router",
        {
          "origin": "https://n"
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/papersplashscreen2.png",
            "enableFullScreenImage_legacy": true,
            "resizeMode": "contain",
            "backgroundColor": "#544D6C"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true,
            "usePrecompiledModules": false
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-sqlite"
    ],
    "slug": "little-ape-movies",
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.markmccoid.littleapemovies"
    },
    "ios": {
      "bundleIdentifier": "com.markmccoid.littleapemovies",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {
        "origin": "https://n"
      },
      "eas": {
        "projectId": "b7df56aa-9e6f-40c6-8e4b-91ccbc5c4596"
      }
    }
  }
}
